{
  "name": "grocery-price-per-unit",
  "version": "2.0.5",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "safari:generate": "npm run build && ./scripts/generate-safari.sh",
    "safari:build": "./scripts/build-safari.sh",
    "safari:install": "./scripts/install-safari.sh",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test tests/e2e/fixture.spec.js tests/e2e/walmart-fixture.spec.js tests/e2e/retailer-fixture.spec.js --project=webkit",
    "test:live": "LIVE_SITE=1 playwright test tests/e2e/live.spec.js --project=webkit --workers=1",
    "test:live:matrix": "LIVE_SITE=1 playwright test tests/e2e/live-matrix.spec.js --project=webkit --workers=1",
    "test:live:hardware": "LIVE_SITE=1 playwright test tests/e2e/live-hardware.spec.js --project=webkit --workers=1",
    "check": "npm run build && npm run lint && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.1",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
